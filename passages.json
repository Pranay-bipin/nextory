<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXTORY - IPMAT Prep Portal</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-page: #f4f7f5;
            --bg-card: #ffffff;
            --bg-subtle: #e8f0eb;
            --border-light: #d1e0d7;
            --border-hover: #a3c7b2;
            --text-heading: #0f291e;
            --text-body: #2d4538;
            --text-muted: #5e7a6b;
            --green-primary: #10b981;
            --green-hover: #047857;
            --green-bg: #ecfdf5;
            --green-border: #a7f3d0;
            --status-correct: #16a34a;
            --status-wrong: #dc2626;
            --shadow-subtle: 0 4px 20px -2px rgba(16, 185, 129, 0.08);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: var(--bg-page); color: var(--text-body); min-height: 100vh; line-height: 1.6; }

        header {
            background: #ffffff;
            border-bottom: 1px solid var(--border-light);
            padding: 14px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.1rem; color: var(--text-heading); }
        .logo-box { background: linear-gradient(135deg, var(--green-primary), #059669); color: #ffffff; padding: 3px 8px; border-radius: 6px; font-size: 0.85rem; font-weight: 800; }
        .sub-tag { background: var(--green-bg); color: var(--green-hover); font-size: 0.75rem; padding: 3px 10px; border-radius: 20px; border: 1px solid var(--green-border); font-weight: 600; }

        .nav-items { display: flex; gap: 8px; flex-wrap: wrap; }
        .nav-btn { background: transparent; border: 1px solid transparent; color: var(--text-muted); padding: 8px 16px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.88rem; transition: all 0.2s ease; }
        .nav-btn.active { background: var(--green-hover); color: #ffffff; }

        .container { max-width: 1220px; margin: 30px auto; padding: 0 20px; }
        .view-panel { display: none; }
        .view-panel.active { display: block; }

        .hero-banner { background: linear-gradient(135deg, #d1fae5 0%, #ecfdf5 100%); border: 1px solid var(--green-border); border-radius: 16px; padding: 32px; margin-bottom: 30px; }
        .primary-btn { background: var(--green-hover); color: #ffffff; border: none; padding: 11px 22px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
        .secondary-btn { background: #ffffff; color: var(--text-heading); border: 1px solid var(--border-light); padding: 11px 22px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; cursor: pointer; }

        .test-split { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 20px; }
        @media (max-width: 900px) { .test-split { grid-template-columns: 1fr; } }

        .reading-box, .question-card { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 14px; padding: 28px; box-shadow: var(--shadow-subtle); position: relative; }
        .reading-box { max-height: 80vh; overflow-y: auto; }
        .meta-tags { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
        .tag { background: var(--bg-subtle); color: var(--text-body); font-size: 0.74rem; padding: 4px 10px; border-radius: 6px; border: 1px solid var(--border-light); font-weight: 700; }
        .passage-body { font-size: 1.02rem; line-height: 1.9; color: #1f3328; white-space: pre-line; text-align: justify; }

        .opt-btn { display: block; width: 100%; text-align: left; background: var(--bg-subtle); border: 1px solid var(--border-light); color: var(--text-heading); padding: 14px 16px; border-radius: 10px; margin-top: 10px; cursor: pointer; font-size: 0.92rem; font-weight: 500; }
        .opt-btn.selected { border-color: var(--green-hover) !important; background: var(--green-hover) !important; color: #ffffff !important; font-weight: 700; }
        .opt-btn.correct { background: #f0fdf4 !important; border-color: var(--status-correct) !important; color: var(--status-correct) !important; font-weight: 700; }
        .opt-btn.wrong { background: #fef2f2 !important; border-color: var(--status-wrong) !important; color: var(--status-wrong) !important; font-weight: 700; }

        .tita-input-box { width: 100%; padding: 14px 18px; font-size: 1.1rem; font-weight: 700; letter-spacing: 0.1em; color: var(--text-heading); background: #ffffff; border: 2px solid var(--border-light); border-radius: 10px; margin-top: 12px; outline: none; }
        .tita-input-box.correct-input { border-color: var(--status-correct); background: #f0fdf4; color: var(--status-correct); }
        .tita-input-box.wrong-input { border-color: var(--status-wrong); background: #fef2f2; color: var(--status-wrong); }

        .q-palette-container { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--border-light); }
        .q-palette-title { font-size: 0.78rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px; display: flex; justify-content: space-between; }
        .q-palette-grid { display: flex; flex-wrap: wrap; gap: 6px; max-height: 180px; overflow-y: auto; }
        .q-grid-btn { width: 32px; height: 32px; border-radius: 6px; border: 1px solid var(--border-light); background: var(--bg-subtle); font-size: 0.76rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
        .q-grid-btn.active-q { border-color: var(--green-hover) !important; box-shadow: 0 0 0 2px var(--green-hover); font-weight: 800; }
        .q-grid-btn.attempted { background: var(--green-hover) !important; color: #ffffff !important; border-color: var(--green-hover) !important; }

        .explanation-box { display: none; margin-top: 18px; padding: 18px; background: var(--green-bg); border-left: 4px solid var(--green-hover); border-radius: 8px; font-size: 0.9rem; color: #064e3b; }
        .submit-btn { width: 100%; background: var(--green-hover); color: #ffffff; border: none; padding: 13px; border-radius: 10px; font-weight: 800; font-size: 0.95rem; cursor: pointer; margin-top: 20px; }

        /* ANALYTICS MODAL OVERRIDE */
        .modal-overlay { display: none; position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(15, 41, 30, 0.8) !important; backdrop-filter: blur(8px); z-index: 999999 !important; justify-content: center; align-items: center; padding: 20px; }
        .modal-overlay.active { display: flex !important; }

        .dashboard-card { background: #ffffff; border: 1px solid var(--border-light); width: 100%; max-width: 840px; border-radius: 20px; padding: 32px; margin: auto; max-height: 90vh; overflow-y: auto; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 12px; margin: 20px 0; }
        .stat-box { background: var(--bg-subtle); padding: 14px; border-radius: 12px; border: 1px solid var(--border-light); text-align: center; }
        .stat-val { font-size: 1.3rem; font-weight: 800; color: var(--text-heading); }
        .stat-lbl { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; margin-top: 4px; font-weight: 700; }

        .dashboard-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 24px 0; }
        .chart-container { background: #fafdfb; border: 1px solid var(--border-light); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 220px; }
        .topic-breakdown-box { background: #fafdfb; border: 1px solid var(--border-light); border-radius: 14px; padding: 20px; }

        .topic-row { margin-bottom: 14px; }
        .topic-header { display: flex; justify-content: space-between; font-size: 0.84rem; font-weight: 700; color: var(--text-heading); margin-bottom: 4px; }
        .progress-bar-bg { background: var(--border-light); height: 8px; border-radius: 4px; overflow: hidden; }
        .progress-bar-fill { height: 100%; border-radius: 4px; }
    </style>
</head>
<body>

    <header>
        <div class="brand"><span class="logo-box">NX</span> NEXTORY <span class="sub-tag">IPMAT Prep Portal</span></div>
        <div class="nav-items">
            <button id="btn-sectional" class="nav-btn active" onclick="showTab('sectional')">⚡ Sectionals</button>
        </div>
    </header>

    <div class="container">
        <div id="panel-sectional" class="view-panel active">
            <div id="sectional-banner-container">
                <div class="question-card" style="text-align:center; padding: 40px;">
                    <h3>Loading IPMAT Indore VA 45-Question Sectional...</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- PERFORMANCE DASHBOARD MODAL -->
    <div id="dashboard-modal" class="modal-overlay">
        <div class="dashboard-card">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div>
                    <h2 style="color:var(--text-heading); font-size:1.5rem; font-weight:800;">📊 Performance & Diagnostic Analysis</h2>
                    <p style="color:var(--text-muted); font-size:0.88rem;">IPMAT Indore Sectional Report</p>
                </div>
                <span class="sub-tag" id="dash-test-title">IPMAT Sectional</span>
            </div>

            <div class="stats-grid">
                <div class="stat-box"><div id="stat-accuracy" class="stat-val" style="color:var(--status-correct)">0%</div><div class="stat-lbl">Accuracy</div></div>
                <div class="stat-box"><div id="stat-speed" class="stat-val">0</div><div class="stat-lbl">Score</div></div>
                <div class="stat-box"><div id="stat-time" class="stat-val">0s</div><div class="stat-lbl">Time Spent</div></div>
                <div class="stat-box"><div id="stat-correct" class="stat-val" style="color:var(--status-correct)">0</div><div class="stat-lbl">Correct</div></div>
                <div class="stat-box"><div id="stat-incorrect" class="stat-val" style="color:var(--status-wrong)">0</div><div class="stat-lbl">Incorrect</div></div>
                <div class="stat-box"><div id="stat-unattempted" class="stat-val">0</div><div class="stat-lbl">Unattempted</div></div>
            </div>

            <div class="dashboard-layout">
                <div class="chart-container">
                    <div style="width:180px; height:180px;">
                        <canvas id="accuracyChart"></canvas>
                    </div>
                </div>
                <div class="topic-breakdown-box">
                    <h4 style="font-size:0.82rem; font-weight:800; text-transform:uppercase; color:var(--text-muted); margin-bottom:14px;">Topic Breakdown</h4>
                    <div id="topic-rows-container"></div>
                </div>
            </div>

            <button class="primary-btn" style="width:100%; justify-content:center; padding:14px;" onclick="closeDashboard()">🔍 Close & Review Test Solutions</button>
        </div>
    </div>

    <script>
        let todaySectional = null;
        let sectionalUserAnswers = {};
        let sectionalSeconds = 2400;
        let sectionalTimerInterval = null;
        let isSectionalSubmitted = false;
        let secCurrentQIndex = 0;
        let accuracyChartInstance = null;

        async function loadSectionalData() {
            try {
                const response = await fetch('sectional.json');
                let sectionals = await response.json();
                if (!Array.isArray(sectionals)) sectionals = [sectionals];
                todaySectional = sectionals[0];
                renderSectionalBanner();
            } catch (err) {
                console.error("Fetch error:", err);
            }
        }

        function renderSectionalBanner() {
            const container = document.getElementById('sectional-banner-container');
            container.innerHTML = `
                <div class="hero-banner">
                    <h1>${todaySectional.title}</h1>
                    <p>Total Questions: <strong>${todaySectional.questions.length} Questions Loaded</strong></p>
                    <button class="primary-btn" onclick="startFullSectionalTest()">🚀 Start Sectional Test</button>
                </div>`;
        }

        function startFullSectionalTest() {
            secCurrentQIndex = 0;
            sectionalUserAnswers = {};
            isSectionalSubmitted = false;
            sectionalSeconds = (todaySectional.durationMinutes || 40) * 60;
            renderSectionalContainerLayout();
            renderSectionalQuestion();
            startSectionalCountdown();
        }

        function renderSectionalContainerLayout() {
            document.getElementById('sectional-banner-container').innerHTML = `<div id="sec-test-wrapper"></div>`;
        }

        function startSectionalCountdown() {
            clearInterval(sectionalTimerInterval);
            sectionalTimerInterval = setInterval(() => {
                sectionalSeconds--;
                const mins = Math.floor(sectionalSeconds / 60).toString().padStart(2, '0');
                const secs = (sectionalSeconds % 60).toString().padStart(2, '0');
                const display = document.getElementById('sec-timer-display');
                if (display) display.innerText = `⏱️ ${mins}:${secs}`;
            }, 1000);
        }

        function renderSectionalQuestion() {
            const qList = todaySectional.questions;
            const q = qList[secCurrentQIndex];
            const wrapper = document.getElementById('sec-test-wrapper');

            const isTITA = (q.type && q.type.toUpperCase().includes("TITA")) || !q.options;
            let inputOptionsHtml = "";

            if (isTITA) {
                const currentVal = sectionalUserAnswers[secCurrentQIndex] || "";
                inputOptionsHtml = `
                    <div style="margin-top: 15px;">
                        <input type="text" class="tita-input-box" value="${currentVal}" placeholder="Type answer..." ${isSectionalSubmitted ? 'disabled' : ''} oninput="handleTITAInput(this.value)">
                    </div>`;
            } else {
                inputOptionsHtml = q.options.map((opt, idx) => {
                    let btnClass = "opt-btn";
                    if (sectionalUserAnswers[secCurrentQIndex] === idx) btnClass += " selected";
                    if (isSectionalSubmitted) {
                        if (idx === q.answer) btnClass += " correct";
                        else if (sectionalUserAnswers[secCurrentQIndex] === idx) btnClass += " wrong";
                    }
                    return `<button class="${btnClass}" onclick="selectSectionalOpt(${idx})">${opt}</button>`;
                }).join('');
            }

            let attemptedCount = Object.keys(sectionalUserAnswers).length;
            const gridBtnsHtml = qList.map((item, idx) => {
                let btnClass = "q-grid-btn";
                if (idx === secCurrentQIndex) btnClass += " active-q";
                if (sectionalUserAnswers[idx] !== undefined && sectionalUserAnswers[idx] !== "") btnClass += " attempted";
                return `<button class="${btnClass}" onclick="jumpToSectionalQ(${idx})">${idx + 1}</button>`;
            }).join('');

            wrapper.innerHTML = `
                <div class="question-card">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                        <h3>Q ${secCurrentQIndex + 1} of ${qList.length}</h3>
                        <span id="sec-timer-display" style="font-weight:800; color:var(--green-hover);">⏱️ 40:00</span>
                    </div>
                    ${q.passage ? `<div class="passage-body" style="margin-bottom:15px; padding:15px; background:var(--bg-subtle); border-radius:8px;">${q.passage}</div>` : ''}
                    <div style="font-weight:700; margin-bottom:15px;">${q.question}</div>
                    <div>${inputOptionsHtml}</div>
                    
                    <div class="q-palette-container">
                        <div class="q-palette-title">Palette Grid (${attemptedCount}/${qList.length} Answered)</div>
                        <div class="q-palette-grid">${gridBtnsHtml}</div>
                    </div>

                    <div style="display:flex; justify-content:space-between; margin-top:20px;">
                        <button class="secondary-btn" onclick="navSectionalQ(-1)">← Prev</button>
                        <button class="secondary-btn" onclick="navSectionalQ(1)">Next →</button>
                    </div>
                    <button class="submit-btn" onclick="submitSectionalTest()">🚀 Submit Sectional Test</button>
                </div>`;
        }

        function handleTITAInput(val) { sectionalUserAnswers[secCurrentQIndex] = val.trim(); }
        function selectSectionalOpt(idx) { sectionalUserAnswers[secCurrentQIndex] = idx; renderSectionalQuestion(); }
        function jumpToSectionalQ(idx) { secCurrentQIndex = idx; renderSectionalQuestion(); }
        function navSectionalQ(dir) {
            if (secCurrentQIndex + dir >= 0 && secCurrentQIndex + dir < todaySectional.questions.length) {
                secCurrentQIndex += dir;
                renderSectionalQuestion();
            }
        }

        function submitSectionalTest() {
            clearInterval(sectionalTimerInterval);
            isSectionalSubmitted = true;
            generateDashboard();
            renderSectionalQuestion();
        }

        function generateDashboard() {
            const qList = todaySectional.questions;
            let correct = 0, incorrect = 0, unattempted = 0;

            qList.forEach((q, idx) => {
                const ans = sectionalUserAnswers[idx];
                const isTITA = (q.type && q.type.toUpperCase().includes("TITA")) || !q.options;
                if (ans === undefined || ans === "") {
                    unattempted++;
                } else if (isTITA) {
                    if (String(ans).trim() === String(q.answer).trim()) correct++;
                    else incorrect++;
                } else {
                    if (parseInt(ans) === parseInt(q.answer)) correct++;
                    else incorrect++;
                }
            });

            document.getElementById('stat-accuracy').innerText = `${Math.round((correct / qList.length) * 100)}%`;
            document.getElementById('stat-speed').innerText = `${(correct * 4) - (incorrect * 1)} / ${qList.length * 4}`;
            document.getElementById('stat-correct').innerText = correct;
            document.getElementById('stat-incorrect').innerText = incorrect;
            document.getElementById('stat-unattempted').innerText = unattempted;

            // SHOW MODAL
            const modal = document.getElementById('dashboard-modal');
            modal.style.setProperty('display', 'flex', 'important');
            modal.classList.add('active');

            // Render Chart safely
            try {
                const ctx = document.getElementById('accuracyChart').getContext('2d');
                if (accuracyChartInstance) accuracyChartInstance.destroy();
                accuracyChartInstance = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Correct', 'Incorrect', 'Unattempted'],
                        datasets: [{ data: [correct, incorrect, unattempted], backgroundColor: ['#16a34a', '#dc2626', '#d1e0d7'] }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });
            } catch(e) { console.warn("Chart error:", e); }
        }

        function closeDashboard() {
            const modal = document.getElementById('dashboard-modal');
            modal.style.setProperty('display', 'none', 'important');
            modal.classList.remove('active');
        }

        function showTab() {}
        loadSectionalData();
    </script>
</body>
</html>
